(defcfg
    ;; ;; linux
    ;; input (device-file "")
    ;; output (uinput-sink "")

    ;; ;; windows (<delay> and <rate> unit is millisecond)
    ;; input (low-level-hook)
    ;; output (send-event-sink [ <delay> <rate> ])

    ;; cmp-seq
    ;; cmp-seq-delay

    fallthrough true
    allow-cmd false
)

(defsrc
    esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
    grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
    caps a    s    d    f    g    h    j    k    l    ;    '    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up
    lctl lmet lalt           spc            ralt rmet      rctl            left down rght
)

#|
(deflayer name
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _                    _
    _    _    _              _              _    _         _               _    _    _
)
|#

(defalias
    fn1 (layer-toggle fn1)
    fn2 (layer-toggle fn2)
    hf1 (tap-hold-next 200 (around esc (pause 35)) @fn1)  ;; hold fn1
    hf2 (tap-hold-next 200 (around grv (pause 35)) @fn2)  ;; hold fn2

    vdl M-C-left   ;; switch virtual desktop to the left
    vdr M-C-right  ;; switch virtual desktop to the right

    adc C-A-f9  ;; cycle default audio device
)

(deflayer base
    grv  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
    @hf2 1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
    @hf1 a    s    d    f    g    h    j    k    l    ;    '    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up
    lctl lmet lalt           spc            ralt rmet      rctl            left down rght
)

(deflayer fn1
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
    esc  _    up   _    _    _    _    _    _    _    _    _    _    _
    _    left down rght _    _    home pgdn pgup end  _    _    _
    caps _    _    _    _    _    _    _    _    _    _    _                    pgup
    _    _    @fn2           _              _    _         _               home pgdn end
)

(deflayer fn2
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    @vdl volu @vdr _    _    _    _    _    _    _    _    _    _
    _    prev vold next _    _    _    _    _    _    _    _    _
    _    pp   mute @adc _    _    _    mute _    _    _    _                    volu
    _    _    _              pp             _    _         _               prev vold next
)

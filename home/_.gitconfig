[init]
    defaultBranch = trunk


[core]
    ignorecase = false
    editor = vim
    safecrlf = true
    autocrlf = input


[merge]
    ff = false


[pull]
    ff = only


[pager]
    ; These pagers might not be available on your platform, therefore it is
    ; recommended to set them locally.

    ; ; `diff-highlight`:
    ; ; ```
    ; ; git config --global pager.log 'diff-highlight | less'
    ; ; git config --global pager.show 'diff-highlight | less'
    ; ; git config --global pager.diff 'diff-highlight | less'
    ; ; ```
    ; log = diff-highlight | less
    ; show = diff-highlight | less
    ; diff = diff-highlight | less

    ; ; `git-delta`:
    ; ; ```
    ; ; git config --global pager.log 'delta'
    ; ; git config --global pager.show 'delta'
    ; ; git config --global pager.diff 'delta'
    ; ; ```
    ; log = delta
    ; show = delta
    ; diff = delta


[delta]
    diff-highlight = true
    file-style = yellow
    file-decoration-style = blue box ul
    hunk-header-style = line-number syntax
    hunk-header-decoration-style = blue box
    zero-style = syntax
    keep-plus-minus-markers = true
    line-numbers = true
    line-numbers-minus-style = red
    line-numbers-zero-style = 253
    line-numbers-plus-style = green


[alias]
    lg = log --decorate=short --author-date-order --graph --date=format:'%F' --format=format:'%>|(9)%C(bold reverse 167) %h %C(120) %ad %C(no-reverse) > %Creset%<(65,trunc)%s%C(bold 229)%d%C(81) <%an>%C(nobold) %G?'
    lga = lg --all
    lgd = log --decorate=short --author-date-order --graph --date=format:'%F' --stat --full-diff --format=format:'%C(bold reverse 167) %h %C(120) %ad %C(no-reverse) > %Creset%<(65,trunc)%s%C(bold 229)%d%C(81) <%an>%C(nobold) %G?%n'
    lgf = log --decorate=full --author-date-order --graph --date=format:'%F %T %z' --format=format:'%C(bold 167)Commit     :%C(reverse) %H %C(no-reverse 229)%d%n%C(bold 120)Author Date:%C(reverse) %ad %C(no-reverse) (%ar)%n%C(bold 229)Parent     :%C(reverse) %P %C(no-reverse)%n%C(bold 81)Author     : %an <%ae>%C(nobold) %G?%n%n%B%n'
    lgfd = lgf --patch --full-diff

    s  = status --short
    sl = status --long

    a  = add --verbose
    aa = add --verbose --all
    ap = add --patch

    d  = diff
    dc = diff --cached
    ds = diff --stat

    skip-add = update-index --skip-worktree
    skip-remove = update-index --no-skip-worktree
    skip-list = ls-files -v . | grep ^S

    cm  = commit --message
    cms = commit --gpg-sign --message
    cn  = commit --allow-empty-message --message ''
    cns = commit --gpg-sign --allow-empty-message --message ''
    ca  = commit --amend
    cas = commit --gpg-sign --amend

    m   = merge
    ms  = merge --gpg-sign
    mnc = merge --no-commit
    mff = merge --ff-only

    fap = fetch --all --prune
    pff = pull --ff-only

    ; blobless clone
    clbl = clone --filter=blob:none
    ; shallow clone
    cls = clone --depth=1


[core]
    ignorecase = false
    editor = vim
    safecrlf = true
    autocrlf = input
[merge]
    ff = false
[pager]
    ; ; `diff-highlight` might not be available on every platform, therefore it is
    ; ; recommended to set these pager locally.
    ; ;
    ; ; You can use the following commands:
    ; ; ```
    ; ; git config --global pager.log 'diff-highlight | less'
    ; ; git config --global pager.show 'diff-highlight | less'
    ; ; git config --global pager.diff 'diff-highlight | less'
    ; ; ```
    ; log = diff-highlight | less
    ; show = diff-highlight | less
    ; diff = diff-highlight | less
[alias]
    lg = log --decorate=short --author-date-order --graph --date=format:'%Y-%m-%d' --format=format:'%>|(9)%C(bold reverse 167) %h %C(120) %ad %C(no-reverse) > %Creset%<(65,trunc)%s%C(bold 229)%d%C(81) <%an>'
    lga = lg --all
    lgd = log --decorate=short --author-date-order --graph --date=format:'%Y-%m-%d' --stat --full-diff --format=format:'%C(bold reverse 167) %h %C(120) %ad %C(no-reverse) > %Creset%<(65,trunc)%s%C(bold 229)%d%C(81) <%an>%n'
    lgf = log --decorate=full --author-date-order --graph --date=format:'%Y-%m-%d %H:%M:%S %z' --format=format:'%C(bold 167)Commit     :%C(reverse) %H %C(no-reverse 229)%d%n%C(bold 120)Author Date:%C(reverse) %ad %C(no-reverse) (%ar)%n%C(bold 229)Parent     :%C(reverse) %P %C(no-reverse)%n%C(bold 81)Author     : %an <%ae>%n%n%B%n'
    lgfd = lgf -p --full-diff
    ada = add --all
    cm = commit -m
    nc = commit --allow-empty-message -m ''
    mnc = merge --no-commit
    mff = merge --ff-only
    pff = pull --ff-only
    skip-add = update-index --skip-worktree
    skip-remove = update-index --no-skip-worktree
    skip-list = ls-files -v . | grep ^S

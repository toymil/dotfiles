#| -------------------------------------------------------------------------------------------------

                               ;; ANSI 100% 104-Key Keyboard Template

(defsrc
    esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12        ssrq slck pause
    grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  ins  home pgup  nlck kp/  kp*  kp-
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     del  end  pgdn  kp7  kp8  kp9  kp+
    caps a    s    d    f    g    h    j    k    l    ;    '    ret                        kp4  kp5  kp6
    lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up         kp1  kp2  kp3  kprt
    lctl lmet lalt           spc            ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(deflayer name
    _    _    _    _    _    _    _    _    _    _    _    _    _          _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _     _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _     _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _                          _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _                    _          _    _    _    _
    _    _    _              _              _    _    _    _               _    _    _     _    _
)

;; -------------------------------------------------------------------------------------------------

                                         ;; LEOPOLD FC660M

(defsrc
    esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc       ins
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \          del
    caps a    s    d    f    g    h    j    k    l    ;    '    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft            up
    lctl lmet lalt           spc            ralt rctl                 left down rght
)

(deflayer name
    _    _    _    _    _    _    _    _    _    _    _    _    _    _          _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _          _
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _               _
    _    _    _              _              _    _                    _    _    _
)

------------------------------------------------------------------------------------------------- |#

(defcfg
    input ()
    output ()

    ;; cmp-seq
    ;; cmp-seq-delay

    fallthrough true
    allow-cmd false
)

(defsrc
    esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
    caps a    s    d    f    g    h    j    k    l    ;    '    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up
    lctl lmet lalt           spc            ralt           rctl            left down rght
)

#|
(deflayer name
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    _    _    _    _    _    _    _    _    _    _                    _
    _    _    _              _              _              _               _    _    _
)
|#

(deflayer base
    grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
    @hf1 a    s    d    f    g    h    j    k    l    ;    '    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up
    lctl lmet lalt           spc            ralt           rctl            left down rght
)

(defalias
    hf1 (tap-hold-next 200 esc (layer-toggle fn1))  ;; hold fn 1
    mec (layer-toggle media-control)  ;; media control
)

(deflayer fn1
    _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
    esc  _    up   _    _    _    _    _    _    _    _    _    _    _
    _    left down rght _    _    home pgdn pgup end  _    _    _
    caps _    _    _    _    _    _    _    _    _    _    _                    pgup
    _    _    @mec           _              _              _               home pgdn end
)

(deflayer media-control
    _    _    _    _    _    _    _    _    _    _    _    _    _    _
    _    _    volu _    _    _    _    _    _    _    _    _    _    _
    _    prev vold next _    _    _    _    _    _    _    _    _
    _    pp   mute _    _    _    _    mute _    _    _    _                    volu
    _    _    _              pp             _              _               prev vold next
)

